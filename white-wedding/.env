# The public address this invitation will live at, with no trailing slash.
#
# It is needed because the canonical link and the Open Graph / Twitter /
# JSON-LD tags in `index.html` all require a full URL rather than a path —
# they are read by crawlers and chat apps that have no page context to
# resolve a relative one against.
#
# Replace the value below with the real domain before the final build:
#
#   VITE_SITE_URL=https://your-domain-here.com
#
# Until then it is left at https://example.com, which is reserved by
# RFC 2606 for exactly this purpose, so an unedited placeholder can
# never point at somebody else's real site.
VITE_SITE_URL=https://example.com
